# Server-side environment variables only (never prefix private keys with VITE_)
# Configure real secrets in your hosting provider's Secrets/Environment panel.

# Required for server-side Gemini AI endpoints (/api/ai/*)
GEMINI_API_KEY=

# Optional news API providers (official public RSS feeds work without a key)
GNEWS_API_KEY=
NEWS_API_KEY=

# Authorised BSE/NSE market data provider (Phase 7 — e.g., Twelve Data / Alpha Vantage)
MARKET_DATA_API_KEY=
MARKET_DATA_PROVIDER=twelvedata

# Runtime configuration
NODE_ENV=development
PORT=3000
APP_URL=
